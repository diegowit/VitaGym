<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VitaGym" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background to white -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>


        <item name="windowSplashScreenAnimatedIcon">@drawable/vitagym_logo</item>

        <!-- The duration the splash screen is displayed. (Android 12+) -->
        <item name="windowSplashScreenAnimationDuration">200</item>

        <!-- Set the theme to be used after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.VitaGym</item>
    </style>
</resources>