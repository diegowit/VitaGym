<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VitaGym" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Match the app dark theme background -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Use the inset icon to prevent cutting -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>

        <!-- Set the background of the icon to give it a clean circular base -->
        <item name="windowSplashScreenIconBackgroundColor">@color/dark_card</item>

        <!-- The duration the splash screen is displayed. -->
        <item name="windowSplashScreenAnimationDuration">300</item>

        <!-- Set the theme to be used after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.VitaGym</item>
    </style>
</resources>
